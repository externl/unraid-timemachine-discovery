#!/bin/bash
#
# Publish the _adisk._tcp record Unraid omits, derived from the running Samba
# config and written as a service group of its own.
#
# Usage: rc.timemachine-discovery [start|stop|restart|reload|enable|disable|status]

SERVICE_FILE="/etc/avahi/services/timemachine.service"
UNRAID_SERVICE="/etc/avahi/services/smb.service"
CFG="/boot/config/plugins/timemachine-discovery/timemachine-discovery.cfg"
TAG="timemachine-discovery"

log() {
  logger -t "$TAG" -- "$*"
  # [ -t 1 ] fails under a pipe; do not let that become the exit status.
  [ -t 1 ] && echo "$*"
  return 0
}

# No config, or an unreadable one, means on: a fresh install works before
# anything is written to the flash.
enabled() {
  ! grep -qs '^SERVICE="\?disable' "$CFG"
}

set_enabled() {
  mkdir -p "$(dirname "$CFG")"
  printf 'SERVICE="%s"\n' "$1" >"$CFG"
}

# XML-escape a share name. Unraid permits & and friends in share names.
xml_escape() {
  local s=$1
  s=${s//&/&amp;}   # first, or it would double-escape the others
  s=${s//</&lt;}
  s=${s//>/&gt;}
  s=${s//\"/&quot;}
  s=${s//\'/&apos;}
  printf '%s' "$s"
}

# Read from the config Samba actually loaded: the keys in
# /boot/config/shares/*.cfg have shifted between releases.
find_tm_shares() {
  testparm -s 2>/dev/null | awk '
    /^[[:space:]]*\[/ {
      share = $0
      gsub(/^[[:space:]]*\[|\][[:space:]]*$/, "", share)
      next
    }
    /^[[:space:]]*fruit:time machine[[:space:]]*=[[:space:]]*[Yy][Ee][Ss][[:space:]]*$/ {
      if (share != "" && tolower(share) != "global") print share
    }
  '
}

# If Limetech ever fixes the generator, stand down rather than publish a
# duplicate service group.
unraid_publishes_adisk() {
  grep -qs '_adisk\._tcp' "$UNRAID_SERVICE"
}

reload_avahi() {
  if pgrep -x avahi-daemon >/dev/null 2>&1; then
    avahi-daemon --reload >/dev/null 2>&1 && return 0
    /etc/rc.d/rc.avahidaemon restart >/dev/null 2>&1
  fi
}

remove_service() {
  rm -f "$SERVICE_FILE"
  reload_avahi
}

generate() {
  if ! enabled; then
    stop
    return 0
  fi

  if unraid_publishes_adisk; then
    log "Unraid now publishes _adisk._tcp itself; removing $SERVICE_FILE"
    stop
    return 0
  fi

  local shares=() tmp i
  mapfile -t shares < <(find_tm_shares)

  if [ ${#shares[@]} -eq 0 ]; then
    if [ -f "$SERVICE_FILE" ]; then
      log "no Time Machine shares found; removing $SERVICE_FILE"
      remove_service
    fi
    return 0
  fi

  tmp=$(mktemp) || return 1
  {
    cat <<EOF
<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Generated by $TAG. Do not edit; regenerated automatically. -->
<service-group>
 <name replace-wildcards="yes">%h</name>
 <service>
  <type>_adisk._tcp</type>
  <port>9</port>
  <txt-record>sys=waMa=0,adVF=0x100</txt-record>
EOF
    for i in "${!shares[@]}"; do
      printf '  <txt-record>dk%d=adVN=%s,adVF=0x82</txt-record>\n' \
             "$i" "$(xml_escape "${shares[i]}")"
    done
    cat <<EOF
 </service>
</service-group>
EOF
  } >"$tmp"

  # Only touch avahi on a real change, so the hooks can fire freely.
  if cmp -s "$tmp" "$SERVICE_FILE"; then
    rm -f "$tmp"
    return 0
  fi

  install -m 0644 "$tmp" "$SERVICE_FILE"
  rm -f "$tmp"
  log "advertising ${#shares[@]} Time Machine share(s): ${shares[*]}"
  reload_avahi
}

stop() {
  if [ -f "$SERVICE_FILE" ]; then
    remove_service
    log "removed $SERVICE_FILE"
  fi
}

# Indent stdin, or print a fallback when there is nothing to show.
indent_or() {
  local out
  out=$(cat)
  if [ -n "$out" ]; then
    printf '%s\n' "$out" | sed 's/^/  /'
  else
    echo "  $1"
  fi
}

status() {
  echo "advertising: $(enabled && echo enabled || echo disabled)"
  echo "service file: $SERVICE_FILE"
  if [ -f "$SERVICE_FILE" ]; then
    echo "--- contents ---"
    cat "$SERVICE_FILE"
  else
    echo "  (not present)"
  fi
  echo
  echo "Time Machine shares in running Samba config:"
  find_tm_shares | indent_or "(none)"
  echo
  echo "multicast dns register: $(testparm -s 2>/dev/null |
    awk -F= '/multicast dns register/ { gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2; exit }')"
  echo
  echo "live mDNS advertisement:"
  timeout 3 avahi-browse -rt _adisk._tcp 2>/dev/null | indent_or "(nothing advertised)"
}

case "${1:-start}" in
  start|reload|refresh) generate ;;
  stop)                 stop ;;
  restart)              stop; generate ;;
  enable)               set_enabled enable; generate ;;
  disable)              set_enabled disable; stop ;;
  status)               status ;;
  *) echo "usage: $0 {start|stop|restart|reload|enable|disable|status}" >&2; exit 1 ;;
esac
